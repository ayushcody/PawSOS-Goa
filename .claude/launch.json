{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pawsos",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--port", "8040"],
      "port": 8040
    },
    {
      "name": "pawsos-open",
      "runtimeExecutable": "env",
      "runtimeArgs": ["DASHBOARD_PASSWORD=", "CHANNEL=simulator", "IGNORE_OPENING_HOURS=true", "ESCALATION_TIMEOUT_SECONDS=30", ".venv/bin/uvicorn", "app.main:app", "--port", "8043"],
      "port": 8043
    }
  ]
}
