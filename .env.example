# Copy to .env and fill in. Never commit .env.

# App
APP_ENV=dev
PORT=8040
PUBLIC_BASE_URL=http://localhost:8040
CHANNEL=simulator                 # simulator | whatsapp | telegram
ESCALATION_TIMEOUT_SECONDS=600    # use 20 for the demo
IGNORE_OPENING_HOURS=false        # true = treat every team as open (demos at night)
REMINDER_WINDOW_HOURS=24          # demo: 720, so a new booking is inside the window
REMINDER_CHECK_SECONDS=300        # demo: 10, so the reminder arrives seconds after booking

# Staff pages. If set, /dashboard and /sim ask for this password (any user name). Set it before using ngrok.
DASHBOARD_PASSWORD=

# Database. This default is the local Docker container (docker compose up -d).
# For Supabase, replace it with the project's connection string.
DATABASE_URL=postgresql+psycopg://pawsos:pawsos@localhost:5440/pawsos
MEDIA_DIR=uploads

# Claude (slice 3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Seconds one triage call may take. One retry, then the case goes on without triage,
# so the first team alert is never more than twice this late.
TRIAGE_TIMEOUT_SECONDS=15

# Telegram bot. Needs CHANNEL=telegram; the token comes from @BotFather. See docs/TELEGRAM_SETUP.md
TELEGRAM_BOT_TOKEN=

# WhatsApp Business Cloud API (slice 9). Needs CHANNEL=whatsapp and all four values; see docs/WHATSAPP_SETUP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v27.0
# Templates for when someone has not written in 24 hours (WhatsApp error 131047).
# Names of templates approved in Meta Business Manager; empty = no fallback. See docs/WHATSAPP_SETUP.md, "Templates".
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_TEAM_ALERT=
WHATSAPP_TEMPLATE_TEAM_ALERT_EXPIRED=
WHATSAPP_TEMPLATE_BOOK_REMINDER=

# Google Calendar (slice 7)
GOOGLE_SERVICE_ACCOUNT_FILE=
# One calendar per camp: camp-slug=calendar-id, separated by commas. Slugs are in seed/camps.json.
CAMP_CALENDARS=

# Voice notes (slice 10). stub = only the simulator's pretend voice notes; off = decline all;
# bhashini = real voice notes through Bhashini (see docs/VOICE_SETUP.md; not yet tried with real keys).
SPEECH_TO_TEXT=stub
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd   # "Initial Pipeline Models" from Bhashini's docs
BHASHINI_DEFAULT_LANGUAGE=kok     # kok | mr | hi | en; used when a voice note has no language (WhatsApp)
BHASHINI_TIMEOUT_SECONDS=20
FFMPEG_PATH=ffmpeg                # turns WhatsApp's OGG/Opus voice notes into WAV for Bhashini

# Public demo on the website (app/sandbox). Each visitor gets private invented numbers.
SANDBOX_SECRET=                   # signs visitors' cookies; set a long random value in production
SANDBOX_TTL_HOURS=24              # demo cases older than this are deleted
SANDBOX_TRIAGE_PER_HOUR=5         # real triage calls per visitor per hour
TRIAGE_DAILY_CAP=300              # real triage calls from all visitors per day
SANDBOX_REQUESTS_PER_MINUTE=40    # messages a visitor may send per minute (polling gets 8x this)
CLIENT_IP_HEADER=                 # behind Cloudflare: CF-Connecting-IP
PUBLIC_DASHBOARD=false            # true = anyone may view the dashboard read-only; photos and actions need the password
